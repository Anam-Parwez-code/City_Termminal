# Copy to .env and fill from Supabase → Project Settings → Database → Connection string (URI)
# Use "Session pooler" (port 6543) if direct db.*.supabase.co fails on your network.

DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

PORT=5000
JWT_SECRET=city-terminal-secret-2026

# Optional: OpenAI for passport scan
# OPENAI_API_KEY=
# PASSPORT_SCAN_METHOD=auto
