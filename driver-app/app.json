{
  "expo": {
    "name": "City Terminal Driver",
    "slug": "city-terminal-driver",
    "scheme": "cityterminaldriver",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["ios", "android", "web"], 
    "splash": {
      "backgroundColor": "#0A0A0B",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Share van location so passengers see live arrival time.",
        "NSLocationAlwaysUsageDescription": "Optional background pings for dispatcher map."
      }
    },
    "android": {
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    }
  }
}