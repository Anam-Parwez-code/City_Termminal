# ── Physical Android / iPhone (Expo Go on real device) ─────────────────────
# 1. PC and phone on SAME WiFi
# 2. Windows CMD: ipconfig  →  copy "IPv4 Address" (e.g. 192.168.1.105)
# 3. Copy this file to .env and paste your IP:

EXPO_PUBLIC_API_URL=http://192.168.1.105:5000

# 4. Allow port 5000 in Windows Firewall if needed
# 5. Backend: cd backend && node server.js
# 6. App: cd mobile-app && npx expo start -c

# Android emulator only (do NOT use on real phone): http://10.0.2.2:5000
